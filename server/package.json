{
  "name": "gkwatch-server",
  "version": "1.0.0",
  "description": "Backend for GKWatch",
  "main": "server.js",
  "engines": {
    "node": ">=20.18.1 <27"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --detectOpenHandles --coverage",
    "test:smoke": "node smoke_test.js",
    "backup": "node utils/backup.js",
    "backup:verify": "node utils/backup.js --verify"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.11.1",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "curl-cffi": "^0.1.50",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "puppeteer": "^24.43.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "axios-mock-adapter": "^2.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.0",
    "brace-expansion": "^5.0.9",
    "glob": "^11.1.0",
    "minimatch": "^10.2.6",
    "picomatch": "^4.0.5",
    "test-exclude": "^8.0.0"
  }
}
